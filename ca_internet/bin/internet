#!/bin/bash

# 脚本所在目录。
# 这里要注意下，如果写 /usr/bin/cd 会有问题。
PATH_SHELL_FOLDER=$(cd `dirname $0`;pwd)

PATH_ROOT=${PATH_SHELL_FOLDER}/..
export PATH_CA_ROOT=${PATH_ROOT}
cd ${PATH_ROOT}

. ${PATH_ROOT}/../ca_root/bin/functions
echo_blue "进入工作目录：$(${SHELL_PWD})"

# 检查并创建必要的目录。
function check_and_create_dirs() {
    local dirs=("private" "certs" "newcerts" "pfx")
    for dir in "${dirs[@]}"; do
        if [ ! -d "$dir" ]; then
            ${SHELL_MKDIR} -p "$dir"
            if [ -d "$dir" ]; then
                echo_yellow "检测到缺少 $dir 目录，已自动创建。"
            else
                echo_red "创建 $dir 目录失败，请检查权限。"
                exit 1
            fi
        fi
    done
}

check_and_create_dirs

# 检查并复制必要的 CA 证书文件。
function check_and_copy_ca_files() {
    local ca_files=(
        "private/ca.service.internet.ppno.net.key.zip"
        "certs/ca.service.internet.ppno.net.crt"
        "private/ca.personal.internet.ppno.net.key.zip"
        "certs/ca.personal.internet.ppno.net.crt"
    )
    
    local missing_files=()
    
    CA_ROOT=${PATH_ROOT}/../ca_root

    for file in "${ca_files[@]}"; do
        if [ ! -f "$file" ]; then
            # 检查 ca_root 目录下是否存在。
            if [ -f "${CA_ROOT}/$file" ]; then
                # 确保目标目录存在。
                local target_dir=$(dirname "$file")
                if [ ! -d "$target_dir" ]; then
                    ${SHELL_MKDIR} -p "$target_dir"
                fi
                # 复制文件。
                ${SHELL_CP} "${CA_ROOT}/$file" "$file"
                if [ -f "$file" ]; then
                    echo_yellow "已从 ca_root 复制 $file"
                else
                    echo_red "复制 $file 失败"
                    exit 1
                fi
            else
                missing_files+=("$file")
            fi
        fi
    done
    
    # 如果有缺失的文件，提示错误。
    if [ ${#missing_files[@]} -gt 0 ]; then
        echo_red "以下 CA 证书文件缺失，请先在 ca_root 中生成证书颁发机构所需要的私钥和机构证书："
        for file in "${missing_files[@]}"; do
            echo_red "  - $file"
        done
        exit 1
    fi
}

check_and_copy_ca_files

PATH_CONFIG=${PATH_ROOT}/conf/internet.conf

CONF_DOM_TEST_PPNO_NET=test.ppno.net
CONF_KEY_TEST_PPNO_NET=${CONF_DOM_TEST_PPNO_NET}.key
CONF_CSR_TEST_PPNO_NET=${CONF_DOM_TEST_PPNO_NET}.csr
CONF_CRT_TEST_PPNO_NET=${CONF_DOM_TEST_PPNO_NET}.crt
CONF_SER_TEST_PPNO_NET=${CONF_SERIAL}0402010104

CONF_DOM_TEST=test.personal
CONF_KEY_TEST=${CONF_DOM_TEST}.key
CONF_CSR_TEST=${CONF_DOM_TEST}.csr
CONF_CRT_TEST=${CONF_DOM_TEST}.crt
CONF_SER_TEST=${CONF_SERIAL}0402010204

CONF_DOM_MSTSC_PPNO_NET=mstsc.ppno.net
CONF_KEY_MSTSC_PPNO_NET=${CONF_DOM_MSTSC_PPNO_NET}.key
CONF_CSR_MSTSC_PPNO_NET=${CONF_DOM_MSTSC_PPNO_NET}.csr
CONF_CRT_MSTSC_PPNO_NET=${CONF_DOM_MSTSC_PPNO_NET}.crt
CONF_SER_MSTSC_PPNO_NET=${CONF_SERIAL}0402010105

########## ########## ########## ########## ##########
# 生成 test.ppno.net 服务端证书请求文件。
function req_test_ppno_net () {
    CONF_EXTENSIONS=v3_test_ppno_net_req
    req_common  ${CONF_KEY_TEST_PPNO_NET}                       \
                ${CONF_CSR_TEST_PPNO_NET}                       \
                ${CONF_SER_TEST_PPNO_NET}                       \
                ${CONF_EXTENSIONS}                              \
                "GlobalDevSign Internet Service Authority"      \
                "test.ppno.net"                                 \
                "test.ppno.net"
}

########## ########## ########## ########## ##########
# 签名 test.ppno.net 服务端证书。
function sign_test_ppno_net () {
    CONF_EXTENSIONS=v3_test_ppno_net
    sign_common  ${CONF_KEY_CA_INTERNET_SERVICE}                \
                    ${CONF_CRT_CA_INTERNET_SERVICE}             \
                    ${CONF_CSR_TEST_PPNO_NET}                   \
                    ${CONF_CRT_TEST_PPNO_NET}                   \
                    ${CONF_SER_TEST_PPNO_NET}                   \
                    ${CONF_EXTENSIONS}
}

########## ########## ########## ########## ##########
# 生成 mstsc.ppno.net RDP 服务端证书请求文件。
function req_mstsc_ppno_net () {
    CONF_EXTENSIONS=v3_mstsc_ppno_net_req
    req_common  ${CONF_KEY_MSTSC_PPNO_NET}                      \
                ${CONF_CSR_MSTSC_PPNO_NET}                      \
                ${CONF_SER_MSTSC_PPNO_NET}                      \
                ${CONF_EXTENSIONS}                              \
                "GlobalDevSign Internet Service Authority"      \
                "mstsc.ppno.net"                                \
                "mstsc.ppno.net"
}

########## ########## ########## ########## ##########
# 签名 mstsc.ppno.net RDP 服务端证书。
function sign_mstsc_ppno_net () {
    CONF_EXTENSIONS=v3_mstsc_ppno_net
    sign_common  ${CONF_KEY_CA_INTERNET_SERVICE}                \
                    ${CONF_CRT_CA_INTERNET_SERVICE}             \
                    ${CONF_CSR_MSTSC_PPNO_NET}                  \
                    ${CONF_CRT_MSTSC_PPNO_NET}                  \
                    ${CONF_SER_MSTSC_PPNO_NET}                  \
                    ${CONF_EXTENSIONS}
}

########## ########## ########## ########## ##########
# 导出 mstsc.ppno.net RDP 服务端证书为 PFX 格式。
function export_mstsc_ppno_net () {
    rm_file ${PATH_ROOT}/private/${CONF_KEY_MSTSC_PPNO_NET}

    unzip_key ${CONF_KEY_MSTSC_PPNO_NET}

    if [ ! -f ${PATH_ROOT}/private/${CONF_KEY_MSTSC_PPNO_NET} ]; then
        echo_yellow "解压密钥失败。"
        exit
    fi

    echo_blue "开始导出 PFX 证书文件。"

    # 创建包含完整证书链的临时文件
    CERT_CHAIN_FILE=${PATH_ROOT}/certs/${CONF_DOM_MSTSC_PPNO_NET}_chain.crt
    ${SHELL_CAT} ${PATH_ROOT}/certs/${CONF_CRT_MSTSC_PPNO_NET} > ${CERT_CHAIN_FILE}
    ${SHELL_ECHO} "" >> ${CERT_CHAIN_FILE}
    ${SHELL_CAT} ${PATH_ROOT}/certs/${CONF_CRT_CA_INTERNET_SERVICE} >> ${CERT_CHAIN_FILE}
    ${SHELL_ECHO} "" >> ${CERT_CHAIN_FILE}
    ${SHELL_CAT} ${PATH_ROOT}/../ca_root/certs/ca.internet.ppno.net.crt >> ${CERT_CHAIN_FILE}
    ${SHELL_ECHO} "" >> ${CERT_CHAIN_FILE}
    ${SHELL_CAT} ${PATH_ROOT}/../ca_root/certs/ca.ppno.net.crt >> ${CERT_CHAIN_FILE}

    ${SHELL_OPENSSL} pkcs12 -export                                \
                    -out ${PATH_ROOT}/pfx/${CONF_DOM_MSTSC_PPNO_NET}.pfx \
                    -inkey ${PATH_ROOT}/private/${CONF_KEY_MSTSC_PPNO_NET} \
                    -in ${PATH_ROOT}/certs/${CONF_CRT_MSTSC_PPNO_NET} \
                    -certfile ${CERT_CHAIN_FILE}

    # 清理临时文件
    ${SHELL_RM} -f ${CERT_CHAIN_FILE}

    ${SHELL_RM} -rf ${PATH_ROOT}/private/${CONF_KEY_MSTSC_PPNO_NET}

    if [ -f ${PATH_ROOT}/pfx/${CONF_DOM_MSTSC_PPNO_NET}.pfx ]; then
        echo_blue "PFX 证书文件导出完成：${PATH_ROOT}/pfx/${CONF_DOM_MSTSC_PPNO_NET}.pfx"

        # 获取证书 SHA1 指纹并生成注册表文件
        CERT_FINGERPRINT=$(${SHELL_OPENSSL} x509 -in ${PATH_ROOT}/certs/${CONF_CRT_MSTSC_PPNO_NET} -fingerprint -sha1 -noout | ${SHELL_SED} 's/sha1 Fingerprint=//' | ${SHELL_SED} 's/:/,/g')

        # 生成 .reg 文件
        REG_FILE=${PATH_ROOT}/pfx/${CONF_DOM_MSTSC_PPNO_NET}.reg
        ${SHELL_ECHO} "Windows Registry Editor Version 5.00" > ${REG_FILE}
        ${SHELL_ECHO} "" >> ${REG_FILE}
        ${SHELL_ECHO} "[HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp]" >> ${REG_FILE}
        ${SHELL_ECHO} "\"SSLCertificateSHA1Hash\"=hex:${CERT_FINGERPRINT}" >> ${REG_FILE}

        echo_blue "注册表文件生成完成：${REG_FILE}"
        echo_yellow "请使用此文件在 Windows 中导入证书。"
    else
        echo_red "PFX 证书文件导出失败。"
    fi
}

########## ########## ########## ########## ##########
# 生成 test 用户证书请求文件。
function req_personal_test () {
    CONF_EXTENSIONS=v3_personal_test_req
    req_common  ${CONF_KEY_TEST}                                \
                ${CONF_CSR_TEST}                                \
                ${CONF_SER_TEST}                                \
                ${CONF_EXTENSIONS}                              \
                "GlobalDevSign Internet Personal Authority"     \
                "user test"                                     \
                "user test"
}

########## ########## ########## ########## ##########
# 签名 test 用户证书。
function sign_personal_test () {
    CONF_EXTENSIONS=v3_personal_test
    sign_common  ${CONF_KEY_CA_INTERNET_PERSONAL}               \
                    ${CONF_CRT_CA_INTERNET_PERSONAL}            \
                    ${CONF_CSR_TEST}                            \
                    ${CONF_CRT_TEST}                            \
                    ${CONF_SER_TEST}                            \
                    ${CONF_EXTENSIONS}
}

case $1 in
    "req_mstsc_ppno_net") req_mstsc_ppno_net;;
    "sign_mstsc_ppno_net") sign_mstsc_ppno_net;;
    "export_mstsc_ppno_net") export_mstsc_ppno_net;;
    "req_test_ppno_net") req_test_ppno_net;;
    "sign_test_ppno_net") sign_test_ppno_net;;
    "req_personal_test") req_personal_test;;
    "sign_personal_test") sign_personal_test;;
    "genkey") genkey  $2 $3 $4 $4;;
esac
