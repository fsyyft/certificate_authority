#!/bin/bash

# 脚本所在目录。
# 这里要注意下，如果写 /usr/bin/cd 会有问题。
PATH_SHELL_FOLDER=$(cd `dirname $0`;pwd)

PATH_ROOT=${PATH_SHELL_FOLDER}/..
export PATH_CA_ROOT=${PATH_ROOT}
cd ${PATH_ROOT}

. ${PATH_ROOT}/bin/functions
echo_blue "进入工作目录：$(${SHELL_PWD})"

# 检查并创建必要的目录
function check_and_create_dirs() {
    local dirs=("private" "certs" "newcerts")
    for dir in "${dirs[@]}"; do
        if [ ! -d "$dir" ]; then
            ${SHELL_MKDIR} -p "$dir"
            if [ -d "$dir" ]; then
                echo_yellow "检测到缺少 $dir 目录，已自动创建。"
            else
                echo_red "创建 $dir 目录失败，请检查权限。"
                exit 1
            fi
        fi
    done
}

check_and_create_dirs

PATH_CONFIG=${PATH_ROOT}/conf/ca.${CONF_DOMAIN}.conf

########## ########## ########## ########## ##########
# 打印脚本用法说明。
function show_usage() {
    local invalid_command=$1

    if [ -n "${invalid_command}" ]; then
        echo_red "未知命令：${invalid_command}"
        echo
    fi

    ${SHELL_ECHO} "用法：${0##*/} <命令> [参数]"
    ${SHELL_ECHO} ""
    ${SHELL_ECHO} "可用命令："
    printf "  %-36s %s\n" "req_ca" "生成根证书请求文件"
    printf "  %-36s %s\n" "selfsign_ca" "自签名根证书"
    printf "  %-36s %s\n" "req_ca_vpn" "生成 VPN 颁发机构证书请求文件"
    printf "  %-36s %s\n" "sign_ca_vpn" "签名 VPN 颁发机构证书"
    printf "  %-36s %s\n" "req_ca_internet" "生成 Internet 颁发机构证书请求文件"
    printf "  %-36s %s\n" "sign_ca_internet" "签名 Internet 颁发机构证书"
    printf "  %-36s %s\n" "req_ca_internet_service" "生成 Internet Service 颁发机构证书请求文件"
    printf "  %-36s %s\n" "sign_ca_internet_service" "签名 Internet Service 颁发机构证书"
    printf "  %-36s %s\n" "req_ca_internet_personal" "生成 Internet Personal 颁发机构证书请求文件"
    printf "  %-36s %s\n" "sign_ca_internet_personal" "签名 Internet Personal 颁发机构证书"
    printf "  %-36s %s\n" "req_ca_vpn_openvpn" "生成 OpenVPN 颁发机构证书请求文件"
    printf "  %-36s %s\n" "sign_ca_vpn_openvpn" "签名 OpenVPN 颁发机构证书"
    printf "  %-36s %s\n" "req_ca_test" "生成测试颁发机构证书请求文件"
    printf "  %-36s %s\n" "sign_ca_test" "签名测试颁发机构证书"
    printf "  %-36s %s\n" "genkey <name> <length> <password>" "生成密钥并压缩到 private 目录（参数依次为名称、长度、密码）"
}

########## ########## ########## ########## ##########
# 生成根证书请求文件。
function req_ca () {
    CONF_EXTENSIONS=v3_ca_root_req
    req_common  ${CONF_KEY_CA}                                  \
                ${CONF_CSR_CA}                                  \
                ${CONF_SER_CA}                                  \
                ${CONF_EXTENSIONS}                              \
                "GlobalDevSign Root CA"                         \
                "ca.${CONF_DOMAIN}"                             \
                "GlobalDevSign Root CA"
}

########## ########## ########## ########## ##########
# 自签名根证书。
function selfsign_ca () {
    CONF_EXTENSIONS=v3_ca_root

    # 删除私钥。
    rm_file private/${CONF_KEY_CA}

    unzip_key ${CONF_KEY_CA}

    if [ ! -f private/${CONF_KEY_CA} ]; then
        echo_yellow "解压密钥失败。"
        exit
    fi

    # 设置当前使用的序列号。
    ${SHELL_ECHO} ${CONF_SER_CA} > serial

    # 删除数据库中的当前使用的序列号。
    del_exists_serial ${CONF_SER_CA}

    ${SHELL_OPENSSL} ca                                         \
                    -selfsign                                   \
                    -config ${PATH_CONFIG}                      \
                    -extensions ${CONF_EXTENSIONS}              \
                    -startdate ${CONF_STARTDATE_ROOT}           \
                    -enddate ${CONF_ENDDATE_ROOT}               \
                    -keyfile private/${CONF_KEY_CA}             \
                    -in certs/${CONF_CSR_CA}                    \
                    -out certs/${CONF_CRT_CA}

    ${SHELL_RM} -rf private/${CONF_KEY_CA}

    if [ -f certs/${CONF_CRT_CA} ]; then
        echo_blue "签名完成。"
    else
        echo_yellow "签名失败。"
    fi
}

########## ########## ########## ########## ##########
# 生成 Internet 颁发机构证书请求文件。
function req_ca_internet () {
    CONF_EXTENSIONS=v3_ca_internet_req
    req_common  ${CONF_KEY_CA_INTERNET}                         \
                ${CONF_CSR_CA_INTERNET}                         \
                ${CONF_SER_CA_INTERNET}                         \
                ${CONF_EXTENSIONS}                              \
                "GlobalDevSign Internet Authority"              \
                "ca.internet.${CONF_DOMAIN}"                    \
                "GlobalDevSign Internet Authority"
}

########## ########## ########## ########## ##########
# 签名 Internet 颁发机构证书。
function sign_ca_internet () {
    sign_common  ${CONF_KEY_CA}                                 \
                    ${CONF_CRT_CA}                              \
                    ${CONF_CSR_CA_INTERNET}                     \
                    ${CONF_CRT_CA_INTERNET}                     \
                    ${CONF_SER_CA_INTERNET}                     \
                    "v3_ca_internet"
}

########## ########## ########## ########## ##########
# 生成 Internet Service  颁发机构证书请求文件。
function req_ca_internet_service () {
    CONF_EXTENSIONS=v3_ca_internet_service_req
    req_common  ${CONF_KEY_CA_INTERNET_SERVICE}                 \
                ${CONF_CSR_CA_INTERNET_SERVICE}                 \
                ${CONF_SER_CA_INTERNET_SERVICE}                 \
