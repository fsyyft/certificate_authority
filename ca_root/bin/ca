    req_common  ${CONF_KEY_CA_VPN_OPENVPN}                      \
                ${CONF_CSR_CA_VPN_OPENVPN}                      \
                ${CONF_SER_CA_VPN_OPENVPN}                      \
                ${CONF_EXTENSIONS}                              \
                "GlobalDevSign OpenVPN Authority"               \
