                    ${CONF_CRT_CA_INTERNET}                     \
                    ${CONF_CSR_CA_INTERNET_SERVICE}             \
                    ${CONF_CRT_CA_INTERNET_SERVICE}             \
                    ${CONF_SER_CA_INTERNET_SERVICE}             \
                    "v3_ca_internet_service"                    \
                    ${CONF_STARTDATE}                           \
                    ${CONF_ENDDATE}
}

########## ########## ########## ########## ##########
# 生成 Internet Personal  颁发机构证书请求文件。
