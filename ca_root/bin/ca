    CONF_EXTENSIONS=v3_ca_vpn_openvpn_req
    req_common  ${CONF_KEY_CA_INTERNET_PERSONAL}                \
                ${CONF_CSR_CA_INTERNET_PERSONAL}                \
                ${CONF_SER_CA_INTERNET_PERSONAL}                \
                ${CONF_EXTENSIONS}                              \
