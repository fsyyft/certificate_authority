#!/bin/bash

# 脚本所在目录。
# 这里要注意下，如果写 /usr/bin/cd 会有问题。
PATH_SHELL_FOLDER=$(cd `dirname $0`;pwd)

PATH_ROOT=${PATH_SHELL_FOLDER}/..
cd ${PATH_ROOT}

. ${PATH_ROOT}/../ca_root/bin/functions
echo_blue "进入工作目录：$(${SHELL_PWD})"

# 检查并创建必要的目录
function check_and_create_dirs() {
    local dirs=("private" "certs" "newcerts")
    for dir in "${dirs[@]}"; do
        if [ ! -d "$dir" ]; then
            ${SHELL_MKDIR} -p "$dir"
            if [ -d "$dir" ]; then
                echo_yellow "检测到缺少 $dir 目录，已自动创建。"
            else
                echo_red "创建 $dir 目录失败，请检查权限。"
                exit 1
            fi
        fi
    done
}

check_and_create_dirs

# 检查并复制必要的 CA 证书文件
function check_and_copy_ca_files() {
    local ca_files=(
        "private/ca.openvpn.vpn.ppno.net.key.zip"
        "certs/ca.openvpn.vpn.ppno.net.crt"
    )
    
    local missing_files=()
    
    CA_ROOT=${PATH_ROOT}/../ca_root

    for file in "${ca_files[@]}"; do
        if [ ! -f "$file" ]; then
            # 检查 ca_root 目录下是否存在
            if [ -f "${CA_ROOT}/$file" ]; then
                # 确保目标目录存在
                local target_dir=$(dirname "$file")
                if [ ! -d "$target_dir" ]; then
                    ${SHELL_MKDIR} -p "$target_dir"
                fi
                # 复制文件
                ${SHELL_CP} "${CA_ROOT}/$file" "$file"
                if [ -f "$file" ]; then
                    echo_yellow "已从 ca_root 复制 $file"
                else
                    echo_red "复制 $file 失败"
                    exit 1
                fi
            else
                missing_files+=("$file")
            fi
        fi
    done
    
    # 如果有缺失的文件，提示错误
    if [ ${#missing_files[@]} -gt 0 ]; then
        echo_red "以下 CA 证书文件缺失，请先在 ca_root 中生成证书颁发机构所需要的私钥和机构证书："
        for file in "${missing_files[@]}"; do
            echo_red "  - $file"
        done
        exit 1
    fi
}

check_and_copy_ca_files

########## ########## ########## ########## ##########
# 打印脚本用法说明。
function show_usage() {
    local invalid_command=$1

    if [ -n "${invalid_command}" ]; then
        echo_red "未知命令：${invalid_command}"
        echo
    fi

    ${SHELL_ECHO} "用法：${0##*/} <命令> [参数]"
    ${SHELL_ECHO} ""
    ${SHELL_ECHO} "可用命令："
    printf "  %-44s %s\n" "req_vpn_openvpn_server <name> <id> <ip>" "生成 OpenVPN 服务端证书请求文件"
    printf "  %-44s %s\n" "sign_vpn_openvpn_server <name> <id> <ip>" "签名 OpenVPN 服务端证书"
    printf "  %-44s %s\n" "req_vpn_openvpn_client <name> <id> <ip>" "生成 OpenVPN 客户端证书请求文件"
    printf "  %-44s %s\n" "sign_vpn_openvpn_client <name> <id> <ip>" "签名 OpenVPN 客户端证书"
    printf "  %-44s %s\n" "genkey <length> <key-pass> <zip-pass>" "批量生成密钥并压缩到 private 目录"
}

PATH_CONFIG=${PATH_ROOT}/conf/vpn.conf

########## ########## ########## ########## ##########
# 生成 OpenVPN 服务端证书请求文件。
function req_vpn_openvpn_server () {
    SERVER_NAME=$1
    SERVER_ID=$2
    SERVER_IP=$3

    SERVER_DOMAIN_BASE=server.openvpn.${CONF_DOMAIN}
    SERVER_DOMAIN=${SERVER_NAME}.${SERVER_DOMAIN_BASE}

    # 服务端如果没有定义专用密钥对，可以只用一个密钥对。
    FILE_KEY=${SERVER_DOMAIN_BASE}.key

    if [ -f private/${SERVER_DOMAIN}.key.zip ]; then
        FILE_KEY=${SERVER_DOMAIN}.key
    fi    

    FILE_CSR=${SERVER_DOMAIN}.csr
    CONF_EXTENSIONS=v3_vpn_openvpn_server_req
    CONF_SERIAL=E3E3E30401010100${SERVER_ID}

    export SUBJ_OPENVPN_SERVER_NAME=${SERVER_NAME}
    export SUBJ_OPENVPN_IP=${SERVER_IP}

    req_common  ${FILE_KEY}                                     \
                ${FILE_CSR}                                     \
                ${CONF_SERIAL}                                  \
                ${CONF_EXTENSIONS}                              \
                "GlobalDevSign OpenVPN Server Authority"        \
                ${SERVER_DOMAIN}                                \
                ${SERVER_DOMAIN}  
 
    unset SUBJ_OPENVPN_SERVER_NAME
    unset SUBJ_OPENVPN_IP
}

########## ########## ########## ########## ##########
# 签名 OpenVPN 服务端证书。
function sign_vpn_openvpn_server () {
    SERVER_NAME=$1
    SERVER_ID=$2
    SERVER_IP=$3

    SERVER_DOMAIN_BASE=server.openvpn.${CONF_DOMAIN}
    SERVER_DOMAIN=${SERVER_NAME}.${SERVER_DOMAIN_BASE}

    FILE_KEY_CA=ca.openvpn.vpn.${CONF_DOMAIN}.key
    FILE_CRT_CA=ca.openvpn.vpn.${CONF_DOMAIN}.crt
    FILE_CSR=${SERVER_DOMAIN}.csr
    FILE_CRT=${SERVER_DOMAIN}.crt
    CONF_EXTENSIONS=v3_vpn_openvpn_server
    CONF_SERIAL=E3E3E30401010100${SERVER_ID}

    export SUBJ_OPENVPN_SERVER_NAME=${SERVER_NAME}
    export SUBJ_OPENVPN_IP=${SERVER_IP}

    sign_common  ${FILE_KEY_CA}                                 \
                    ${FILE_CRT_CA}                              \
                    ${FILE_CSR}                                 \
                    ${FILE_CRT}                                 \
                    ${CONF_SERIAL}                              \
                    ${CONF_EXTENSIONS}

    export SUBJ_OPENVPN_SERVER_NAME=${SERVER_NAME}
    export SUBJ_OPENVPN_IP=${SERVER_IP}

    
    unset SUBJ_OPENVPN_SERVER_NAME
    unset SUBJ_OPENVPN_IP
}

########## ########## ########## ########## ##########
# 生成 OpenVPN 客户端证书请求文件。
function req_vpn_openvpn_client () {
    CLIENT_NAME=$1
    CLIENT_ID=$2
    CLIENT_IP=$3

    CLIENT_DOMAIN_BASE=openvpn.${CONF_DOMAIN}
    CLIENT_DOMAIN=${CLIENT_NAME}.${CLIENT_DOMAIN_BASE}

    FILE_KEY=${CLIENT_DOMAIN}.key
    FILE_CSR=${CLIENT_DOMAIN}.csr
    CONF_EXTENSIONS=v3_vpn_openvpn_client_req
    CONF_SERIAL=E3E3E30401010101${CLIENT_ID}

    export SUBJ_OPENVPN_CLIENT_NAME=${CLIENT_NAME}
    export SUBJ_OPENVPN_IP=${CLIENT_IP}

    req_common  ${FILE_KEY}                                     \
                ${FILE_CSR}                                     \
                ${CONF_SERIAL}                                  \
                ${CONF_EXTENSIONS}                              \
                "GlobalDevSign OpenVPN Client Authority"        \
                ${CLIENT_DOMAIN}                                \
                ${CLIENT_DOMAIN}  
   
    unset SUBJ_OPENVPN_CLIENT_NAME
    unset SUBJ_OPRNVPN_IP
}

########## ########## ########## ########## ##########
# 签名 OpenVPN 客户端证书。
function sign_vpn_openvpn_client () {
    CLIENT_NAME=$1
    CLIENT_ID=$2
    CLIENT_IP=$3

    CLIENT_DOMAIN_BASE=openvpn.${CONF_DOMAIN}
    CLIENT_DOMAIN=${CLIENT_NAME}.${CLIENT_DOMAIN_BASE}

    FILE_KEY_CA=ca.openvpn.vpn.${CONF_DOMAIN}.key
    FILE_CRT_CA=ca.openvpn.vpn.${CONF_DOMAIN}.crt
    FILE_CSR=${CLIENT_DOMAIN}.csr
    FILE_CRT=${CLIENT_DOMAIN}.crt
    CONF_EXTENSIONS=v3_vpn_openvpn_client
    CONF_SERIAL=E3E3E30401010101${CLIENT_ID}

    export SUBJ_OPENVPN_CLIENT_NAME=${CLIENT_NAME}
    export SUBJ_OPENVPN_IP=${CLIENT_IP}

    sign_common  ${FILE_KEY_CA}                                 \
                    ${FILE_CRT_CA}                              \
                    ${FILE_CSR}                                 \
                    ${FILE_CRT}                                 \
                    ${CONF_SERIAL}                              \
                    ${CONF_EXTENSIONS}    
    
    unset SUBJ_OPENVPN_CLIENT_NAME
    unset SUBJ_OPRNVPN_IP
}

case $1 in
    "req_vpn_openvpn_server") req_vpn_openvpn_server $2 $3 $4;;
    "sign_vpn_openvpn_server") sign_vpn_openvpn_server $2 $3 $4;;
    "req_vpn_openvpn_client") req_vpn_openvpn_client $2 $3 $4;;
    "sign_vpn_openvpn_client") sign_vpn_openvpn_client $2 $3 $4;;
    "genkey") genkey  $2 $3 $4 $4;;
    "help"|"-h"|"--help"|"") show_usage "";;
    *) show_usage "$1"; exit 0;;
esac
