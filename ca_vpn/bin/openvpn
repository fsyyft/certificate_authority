#!/bin/bash

# 脚本所在目录。
# 这里要注意下，如果写 /usr/bin/cd 会有问题。
PATH_SHELL_FOLDER=$(cd `dirname $0`;pwd)

PATH_ROOT=${PATH_SHELL_FOLDER}/..
PATH_CMD=${PATH_ROOT}/bin/vpn
export PATH_CA_ROOT=${PATH_ROOT}
cd ${PATH_ROOT}

. ${PATH_ROOT}/../ca_root/bin/functions
echo_blue 进入工作目录：$(${SHELL_PWD})

# 域名后缀。
DOMAIN_SUFFIX="openvpn.ppno.net"

# 服务端配置列表：格式为 name:id:ip。
declare -a servers=(
    "qd:35:172.27.53.1"
    "pi:0A:172.27.16.1"
    "wd:D5:172.27.213.1"
)

# 客户端配置列表：格式为 name:id:ip。
declare -a clients=(
    "teach.home:06:172.27.XXX.6"
    "hp.home:0A:172.27.XXX.10"
    "test.home:0E:172.27.XXX.14"
    "mac.home:12:172.27.XXX.18"
    "stock.home:16:172.27.XXX.22"
    "asus.home:1A:172.27.XXX.26"
    "route.home:1E:172.27.XXX.30"
    "temp.virtual:22:172.27.XXX.34"
    "internet.virtual:26:172.27.XXX.38"
    "research.virtual:2A:172.27.XXX.42"
    "test.virtual:2E:172.27.XXX.46"
    "vps:32:172.27.XXX.50"
    "test.work:36:172.27.XXX.54"
    "dev.work:3A:172.27.XXX.58"
    "transfer.work:3E:172.27.XXX.62"
    "beta.work:42:172.27.XXX.66"
    "ffs.mobile:46:172.27.XXX.70"
    "test.mobile:4A:172.27.XXX.74"
    "cz.mobile:4E:172.27.XXX.78"
    "ipad.mobile:52:172.27.XXX.82"
    "fsc.mobile:56:172.27.XXX.86"
    "iphone.mobile:5A:172.27.XXX.90"
    "csy.mobile:5E:172.27.XXX.94"
)

########## ########## ########## ########## ##########
# 打印脚本用法说明。
function show_usage() {
    local invalid_command=$1

    if [ -n "${invalid_command}" ]; then
        echo_red "未知命令：${invalid_command}"
        echo
    fi

    ${SHELL_ECHO} "用法：${0##*/} <命令> [参数]"
    ${SHELL_ECHO} ""
    ${SHELL_ECHO} "可用命令："
    printf "  %-40s %s\n" "server <name>" "生成并签名 OpenVPN 服务端证书"
    printf "  %-40s %s\n" "client <name>" "生成并签名 OpenVPN 客户端证书"
    printf "  %-40s %s\n" "genkey <length> <key-pass> <zip-pass>" "批量生成密钥并压缩到 private 目录"
}

########## ########## ########## ########## ##########
# 生成并签名 OpenVPN 服务端证书。
# 参数1：证书名称；通过证书名称，转换出证书编号和使用证书的地址。
function server() {
    SERVER_NAME=$1
    SERVER_ID=00
    SERVER_IP="172.27.XXX.1"
    FOUND=0

    for server in "${servers[@]}"; do
        IFS=':' read -r name id ip <<< "$server"
        if [ "$name" = "$SERVER_NAME" ]; then
            SERVER_ID=$id
            SERVER_IP=$ip
            FOUND=1
            break
        fi
    done

    if [ $FOUND -eq 0 ]; then
        echo_red "错误：找不到服务端配置 '${SERVER_NAME}'"
    else
        echo_yellow "OpenVPN 服务端 ID：${SERVER_ID}"
        echo_yellow "OpenVPN 服务端 IP：${SERVER_IP}"

        echo_yellow "开始生成请求证书。"
        ${PATH_CMD} req_vpn_openvpn_server ${SERVER_NAME} ${SERVER_ID} ${SERVER_IP}
        echo_yellow "完成生成请求证书。"
        echo_yellow "开始请求证书签名。"
        ${PATH_CMD} sign_vpn_openvpn_server ${SERVER_NAME} ${SERVER_ID} ${SERVER_IP}
        echo_yellow "完成请求证书签名。"
    
        ${SHELL_LS} -la certs/| ${SHELL_GREP} ${SERVER_NAME}
    fi
}

########## ########## ########## ########## ##########
# 生成并签名 OpenVPN 客户端证书。
# 参数1：证书名称；通过证书名称，转换出证书编号和使用证书的地址。
function client() {
    CLIENT_NAME=$1
    CLIENT_ID=00
    CLIENT_IP="172.27.XXX.0"
    FOUND=0

    for client in "${clients[@]}"; do
        IFS=':' read -r name id ip <<< "$client"
        if [ "$name" = "$CLIENT_NAME" ]; then
            CLIENT_ID=$id
            CLIENT_IP=$ip
            FOUND=1
            break
        fi
    done

    if [ $FOUND -eq 0 ]; then
        echo_red "错误：找不到客户端配置 '${CLIENT_NAME}'"
    else
        echo_yellow "OpenVPN 客户端 ID：${CLIENT_ID}"
        echo_yellow "OpenVPN 客户端 IP：${CLIENT_IP}"

        echo_yellow "开始生成请求证书。"
        ${PATH_CMD} req_vpn_openvpn_client ${CLIENT_NAME} ${CLIENT_ID} ${CLIENT_IP}
        echo_yellow "完成生成请求证书。"
        echo_yellow "开始请求证书签名。"
        ${PATH_CMD} sign_vpn_openvpn_client ${CLIENT_NAME} ${CLIENT_ID} ${CLIENT_IP}
        echo_yellow "完成请求证书签名。"
        
        ${SHELL_LS} -la certs/ | ${SHELL_GREP} ${CLIENT_NAME}
    fi
}

########## ########## ########## ########## ##########
# 生成密钥。并将密钥加密压缩后存储到 private 目录。
# 参数1：密钥长度。
# 参数2：密钥的密码。
# 参数3：密钥压缩包的密码。
function genkey() {
    KEY_SIZE=$1
    KEY_PASS=$2
    ZIP_PASS=$3

    # 服务端证书：使用循环生成。
    for server in "${servers[@]}"; do
        IFS=':' read -r name id ip <<< "$server"
        echo "------------------------------------------"
        keyname=${name}.server.${DOMAIN_SUFFIX}
        echo "生成服务端密钥：${keyname}, IP: ${ip}"
        ${PATH_CMD} genkey ${keyname} ${KEY_SIZE} ${KEY_PASS} ${ZIP_PASS}
        echo "------------------------------------------"
    done

    # 客户端证书：使用循环生成。
    for client in "${clients[@]}"; do
        IFS=':' read -r name id ip <<< "$client"
        echo "------------------------------------------"
        keyname=${name}.${DOMAIN_SUFFIX}
        echo "生成客户端密钥：${keyname}, IP: ${ip}"
        ${PATH_CMD} genkey ${keyname} ${KEY_SIZE} ${KEY_PASS} ${ZIP_PASS}
        echo "------------------------------------------"
    done
}

case $1 in
    "server") server $2;;
    "client") client $2;;
    "genkey") genkey $2 $3 $4;;
    "help"|"-h"|"--help"|"") show_usage "";;
    *) show_usage "$1"; exit 0;;
esac
